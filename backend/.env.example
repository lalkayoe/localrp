LOCALRP_JWT_SECRET=change_this_to_a_random_64_char_string
LOCALRP_CSRF_SECRET=change_this_to_a_different_random_string
LOCALRP_DEFAULT_PROVIDER=ollama
LOCALRP_DEFAULT_MODEL=gemma-4-26b
LOCALRP_DEFAULT_API_BASE=http://localhost:11434
LOCALRP_PORT=8420
# How long an access token is valid before the frontend needs a silent
# /auth/refresh call. Higher = fewer background refresh calls; doesn't by
# itself change how long you can be inactive before losing the session —
# that's governed by LOCALRP_REFRESH_TOKEN_TTL_DAYS below.
LOCALRP_ACCESS_TOKEN_TTL_MINUTES=60
LOCALRP_REFRESH_TOKEN_TTL_DAYS=30
# How long (seconds) to wait for a non-streaming provider response, e.g. the
# hidden memory-extraction call. Raise this if you're on slower hardware and
# see "Memory extraction request to the model provider failed" in the logs.
LOCALRP_PROVIDER_REQUEST_TIMEOUT_SECONDS=300
# How much of the prompt budget the retrieval engine is allowed to fill with
# injected memory (characters/facts/events/etc). Raise this if you bumped
# context size and want more room for memory vs. raw conversation history.
LOCALRP_MEMORY_MAX_INJECTED_TOKENS=3000
# How many SceneSummaries pile up before they're auto-compressed into one
# ArcSummary (long-term "story so far" memory that survives even after the
# raw messages and individual scenes have scrolled out of context).
LOCALRP_ARC_SUMMARY_EVERY_N_SCENES=5
